# Copy to .env.local and fill in.

# Required for parsing real riders. Without it the app runs on the seeded demo only.
ANTHROPIC_API_KEY=

# Models (defaults shown). Sonnet for parse and match; Haiku for the chaser later.
PARSE_MODEL=claude-sonnet-5-5
MATCH_MODEL=claude-sonnet-5-5
CHASE_MODEL=claude-haiku-5-5

# Local SQLite by default. For hosted: a libSQL/Turso URL plus DATABASE_AUTH_TOKEN,
# or switch the Drizzle driver to Postgres (see README).
DATABASE_URL=file:./data/advance.db
DATABASE_AUTH_TOKEN=

# Where uploaded riders are stored (local disk for now).
UPLOAD_DIR=./data/uploads
